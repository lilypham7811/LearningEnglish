{
  "manifest_version": 3,
  "name": "Save to LearningEnglish",
  "short_name": "LearningEnglish",
  "version": "1.0.0",
  "description": "Lưu video YouTube và bài báo vào app Shadow English (LearningEnglish) để học với Google AI.",
  "action": { "default_title": "Save to LearningEnglish (Alt+Shift+S)" },
  "background": { "service_worker": "background.js" },
  "permissions": ["contextMenus", "scripting", "activeTab", "storage"],
  "host_permissions": ["http://localhost:8000/*"],
  "content_scripts": [
    { "matches": ["http://localhost:8000/*"], "js": ["app-bridge.js"], "run_at": "document_idle" }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Lưu trang này vào LearningEnglish"
    }
  }
}
