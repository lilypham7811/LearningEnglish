{
  "manifest_version": 3,
  "name": "Save to LearningEnglish",
  "short_name": "LearningEnglish",
  "version": "1.5.0",
  "description": "Lưu video YouTube và bài báo vào app Shadow English (LearningEnglish) để học với Google AI.",
  "action": { "default_title": "Save to LearningEnglish (Alt+Shift+S)" },
  "background": { "service_worker": "background.js" },
  "permissions": ["contextMenus", "scripting", "activeTab"],
  "host_permissions": ["https://lilypham7811.github.io/LearningEnglish/*", "https://www.youtube.com/*", "https://www.youtube-nocookie.com/*"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Lưu trang này vào LearningEnglish"
    }
  }
}
